msgid "plugins.importexport.fullJournal.displayName"
msgstr "Full Journal Transfer Plugin"

msgid "plugins.importexport.fullJournal.description"
msgstr "Exports and imports a whole journal (settings, users, issues, articles with their editorial workflow, activity log and usage statistics) between OJS 3.5 installations. Command line only."

msgid "plugins.importexport.fullJournal.cliUsage"
msgstr ""
"Usage: {$scriptName} {$pluginName} [command] ...\n"
"Commands:\n"
"  export [archive.tar.gz] [journal_path] [options]\n"
"  import [archive.tar.gz] [user_name] [options]\n"
"Options:\n"
"  --no-metrics        do not export/import the usage statistics\n"
"  --no-activity-log   do not export/import the activity log (event log, e-mail log) of the submissions\n"
"  --no-public-files   do not export/import the public files of the journal (logos, favicon, stylesheet, covers)\n"
"  --journal-path <path>  use this path (URL) for the imported journal instead of the exported one\n"

msgid "plugins.importexport.fullJournalTransfer.attention"
msgstr "Attention"

msgid "plugins.importexport.fullJournalTransfer.guiAttentionMessage"
msgstr "This plugin can only be used from the command line. The use via the graphical interface is not supported.<br>"
"For more information, check the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://github.com/academic-journals-cz/fullJournalTransfer#instructions-for-use\">instructions for use</a>."

