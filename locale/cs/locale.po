msgid "plugins.importexport.fullJournal.displayName"
msgstr "Plugin pro přenos celého časopisu"

msgid "plugins.importexport.fullJournal.description"
msgstr "Exportuje a importuje celý časopis (nastavení, uživatele, čísla, články včetně redakčního procesu, log aktivity a statistiky využití) mezi instalacemi OJS 3.5. Pouze z příkazové řádky."

msgid "plugins.importexport.fullJournal.cliUsage"
msgstr ""
"Použití: {$scriptName} {$pluginName} [příkaz] ...\n"
"Příkazy:\n"
"  export [archiv.tar.gz] [cesta_časopisu] [volby]\n"
"  import [archiv.tar.gz] [uživatelské_jméno] [volby]\n"
"Volby:\n"
"  --no-metrics        neexportovat/neimportovat statistiky využití\n"
"  --no-activity-log   neexportovat/neimportovat log aktivity (event log, e-mailový log) příspěvků\n"
"  --no-public-files   neexportovat/neimportovat veřejné soubory časopisu (loga, favicon, styly, obálky)\n"
"  --journal-path <cesta> použít pro importovaný časopis tuto cestu (URL) místo exportované\n"

msgid "plugins.importexport.fullJournalTransfer.attention"
msgstr "Upozornění"

msgid "plugins.importexport.fullJournalTransfer.guiAttentionMessage"
msgstr "Tento plugin lze používat pouze z příkazové řádky. Použití přes webové rozhraní není podporováno.<br>"
"Další informace najdete v <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://github.com/academic-journals-cz/fullJournalTransfer#instructions-for-use\">návodu k použití</a>."

